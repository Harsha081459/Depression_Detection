# Create a free Reddit app (takes a few minutes):
# 1. Log in at https://www.reddit.com
# 2. Open https://www.reddit.com/prefs/apps
# 3. Click "create another app..."
# 4. Name: AIX PE Research Collector
# 5. Type: script
# 6. Redirect URI: http://localhost:8080
# 7. Create app
# 8. client_id is the short string under the app name
# 9. client_secret is the value labelled "secret"
#
# Copy this file to .env and fill in the values.

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=AIX-PE-DS-collector/0.1 by u/YourRedditUsername

# Optional. Read-only public collection does not need these.
# REDDIT_USERNAME=
# REDDIT_PASSWORD=
